      "coverage": "executable_limited"
    },
    {
      "id": "age",
      "importance": "PATH",
      "description": "Child/adult/older routing",
      "coverage": "executable_limited"
    },
    {
      "id": "household",
      "importance": "CALCULATION",
      "description": "Applicant-specific MAGI family size",
      "coverage": "executable_limited"
    },
    {
      "id": "income",
