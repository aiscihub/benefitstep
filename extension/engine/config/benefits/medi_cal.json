          }
        }
      ],
      "otherwise": {
        "status": "needs_review",
        "code": "mc_income_unresolved",
        "text": "A scoped income comparison cannot be completed."
      },
      "priority": 18,
      "when": {
        "op": "lt",
        "args": [
          {
            "fact": "shared.age_years"
          },
          {
            "literal": 19
          }
        ]
      }
    },
    {
